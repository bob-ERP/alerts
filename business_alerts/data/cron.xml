<odoo>

    <record id="alerts_cron" model="ir.cron">
        <field name="active" eval="True"/>
        <field name="model_id" ref="business_alerts.model_alert_scenario"/>
        <field name="name">Business Alerts: Alerts</field>
        <field name="state">code</field>
        <field name="code">model.cron_trigger_alert_jobs()</field>
        <field name='interval_number'>1</field>
        <field name='interval_type'>days</field>
        <field name="numbercall">-1</field>
    </record>

    <record id="cron_reset_suspended_alerts" model="ir.cron">
        <field name="active" eval="True"/>
        <field name="model_id" ref="business_alerts.model_alert_scenario"/>
        <field name="name">Business Alerts: Reset Suspended Alerts</field>
        <field name="state">code</field>
        <field name="code">model.cron_reset_suspended_alerts()</field>
        <field name='interval_number'>1</field>
        <field name='interval_type'>days</field>
        <field name="numbercall">-1</field>
    </record>

</odoo>
