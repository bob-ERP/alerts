<odoo>

    <record id="alert_scenario_tree_view" model="ir.ui.view">
        <field name="name">alert.scenario.tree</field>
        <field name="model">alert.scenario</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'enabled' and active == True" decoration-danger="state == 'suspended'" decoration-muted="active == False">
                <field name="active" column_invisible="1"/>
                <field name="model_id" />
                <field name="name" string="Alert Scenario"/>
                <field name="alert_function" />
                <field name="value" />
                <field name="records_domain" />
                <field name="notification" />
                <field name="severity" />
                <field name="webhook_url" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="alert_scenario_form_view" model="ir.ui.view">
        <field name="name">alert.scenario.form</field>
        <field name="model">alert.scenario</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group name="top">
                        <group>
                            <field name="name"/>
                            <field name="alert_type"/>
                            <field name="mail_template_id" invisible="alert_type != 'email'" required="alert_type == 'email'"/>
                            <field name="model_id"/>
                            <field name="alert_function"/>
                            <field name="time_frame" invisible="alert_function != 'time'" required="alert_function == 'time'" />
                            <field name="time_unit" invisible="alert_function != 'time'" required="alert_function == 'time'" />
                            <field name="time_field_id" domain="[('model_id', '=', model_id), ('ttype', 'in', ['datetime', 'date'])]" invisible="alert_function != 'time'" required="alert_function == 'time'" />
                            <field name="value" invisible="alert_function != 'count'"/>
                            <field name="user_id"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="notification"/>
                        </group>
                        <group>
                            <field name="severity"/>
                            <field name="action_id"/>
                            <field name="webhook_url"/>
                            <field name="model" readonly="1" invisible="1"/>
                            <field name="records_domain" widget="domain" options="{'model': 'model'}" />
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" options="{'post_refresh': 'recipients'}"/>
                </div>
            </form>
        </field>
    </record>

    <record id="alert_scenario_filter" model="ir.ui.view">
        <field name="name">alert.scenario.search</field>
        <field name="model">alert.scenario</field>
        <field name="arch" type="xml">
            <search string="Alerts">
                <filter string="All" name="all" domain="['|', ('active', '=', False), ('active', '=', True)]"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Enabled" name="enabled" domain="[('state', '=', 'enabled')]"/>
                <filter string="Suspended" name="suspended" domain="[('state', '=', 'suspended')]"/>
            </search>
        </field>
    </record>

    <record id="action_alert_scenario" model="ir.actions.act_window">
        <field name="name">Alert Scenarios</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">alert.scenario</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_all': 1}</field>
    </record>

    <menuitem id="menu_alert_scenario_root" name="Alert Scenarios" action="action_alert_scenario" web_icon="business_alerts,static/description/icon.png" />

</odoo>
