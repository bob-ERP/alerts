<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.alerts</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Business Alerts" data-string="Business Alerts" name="business_alerts" groups="base.group_system">
                    <block title="Configuration" name="business_alerts_setting_container">
                        <setting id="alerts_evalution" help="Evaluate enabled alert scenarios and send notifications.">
                            <field name="alerts_evaluation"/>
                        </setting>
                        <setting id="reset_suspended_alerts" help="Re-enable alert scenarios that moved to Suspended after firing.">
                            <field name="reset_suspended_alerts"/>
                        </setting>
                        <setting id="evaluation_time_frame">
                            <field name="evaluation_time_frame"/>
                        </setting>
                        <setting id="reset_suspended_alerts_time_frame">
                            <field name="reset_suspended_alerts_time_frame"/>
                        </setting>
                        <setting id="evaluation_time_unit" help="Shorter intervals increase load; start with 15 minutes unless you need tighter monitoring.">
                            <field name="evaluation_time_unit"/>
                        </setting>
                        <!-- <setting id="reset_suspended_alerts_time_frame">
                            <field name="reset_suspended_alerts_time_frame"/>
                        </setting> -->
                        <setting id="reset_suspended_alerts_time_unit" help="Shorter intervals increase load; start with 15 minutes unless you need tighter monitoring.">
                            <field name="reset_suspended_alerts_time_unit"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_business_alerts_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'business_alerts', 'bin_size': False}</field>
    </record>
</odoo>